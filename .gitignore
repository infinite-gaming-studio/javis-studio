# ============================================
# 全局忽略规则 (第一性原理: 只保留源代码和配置)
# ============================================

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 日志文件 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# Frontend (Next.js)
# ============================================
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions

# testing
/frontend/coverage

# next.js build output
/frontend/.next/
/frontend/out/
/frontend/dist/
/frontend/build

# misc
/frontend/*.pem
/frontend/.env*
!/frontend/.env.example

# vercel
/frontend/.vercel

# typescript
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts

# generated audio files (runtime生成)
/frontend/public/audio/*.wav
/frontend/public/audio/*.mp3

# ============================================
# Backend (Python/FastAPI)
# ============================================
# Python
/backend/__pycache__/
/backend/**/__pycache__/
/backend/*.py[cod]
/backend/*$py.class
/backend/*.so

# Virtual environments
/backend/.venv/
/backend/venv/
/backend/ENV/
/backend/env/
/backend/.env

# Distribution / packaging
/backend/dist/
/backend/build/
/backend/*.egg-info/

# pytest
/backend/.pytest_cache/
/backend/.coverage
/backend/htmlcov/

# mypy
/backend/.mypy_cache/
/backend/.dmypy.json
/backend/dmypy.json

# uploads and generated files (runtime生成)
/backend/storage/*
!/backend/storage/.gitkeep

# ============================================
# Docker
# ============================================
.env
.env.local
.env.*.local

# ============================================
# Docs (如果有构建产物)
# ============================================
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/docs/node_modules/
